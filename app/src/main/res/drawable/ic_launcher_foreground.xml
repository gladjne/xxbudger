<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sparkle Star 1: Cyan glow on the left -->
    <path
        android:fillColor="#80DEEA"
        android:pathData="M27,24 L28.2,27.5 L31.7,28.7 L28.2,29.9 L27,33.4 L25.8,29.9 L22.3,28.7 L25.8,27.5 Z" />

    <!-- Sparkle Star 2: Gold glow on the right -->
    <path
        android:fillColor="#FFF59D"
        android:pathData="M78,16 L79.5,20.2 L83.7,21.7 L79.5,23.2 L78,27.4 L76.5,23.2 L72.3,21.7 L76.5,20.2 Z" />

    <!-- Floating Wealth Coin (Joy Smiley) -->
    <path
        android:pathData="M 54,21.5 a 12.5,12.5 0 1,1 -0.001,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="9"
                android:endX="54"
                android:endY="34"
                android:type="linear">
                <item android:color="#FFE082" android:offset="0.0" />
                <item android:color="#FF8F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Smile components of the Joy Coin -->
    <!-- Eyes -->
    <path
        android:fillColor="#5D4037"
        android:pathData="M 49.5,29.8 a 1.2,1.2 0 1,1 -0.001,0 z" />
    <path
        android:fillColor="#5D4037"
        android:pathData="M 58.5,29.8 a 1.2,1.2 0 1,1 -0.001,0 z" />
    
    <!-- Curved Joy smile mouth -->
    <path
        android:strokeColor="#7E57C2"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 49.5,33.5 Q 54,37.5 58.5,33.5" />

    <!-- Sleek Wallet Body with rounded edges -->
    <path
        android:pathData="M 35,48.5 h 38 a 6,6 0 0 1 6,6 v 20 a 6,6 0 0 1 -6,6 h -38 a 6,6 0 0 1 -6,-6 v -20 a 6,6 0 0 1 6,-6 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="48.5"
                android:endX="77"
                android:endY="80.5"
                android:type="linear">
                <item android:color="#5C6BC0" android:offset="0.0" />
                <item android:color="#8E24AA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Horizontal Wallet strap/flap -->
    <path
        android:pathData="M 50.5,56.5 h 25.5 a 3.2,3.2 0 0 1 3.2,3.2 v 8.6 a 3.2,3.2 0 0 1 -3.2,3.2 h -25.5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50.5"
                android:startY="56.5"
                android:endX="79.2"
                android:endY="71.5"
                android:type="linear">
                <item android:color="#311B92" android:offset="0.0" />
                <item android:color="#1A237E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Metallic snap stud on the strap -->
    <path
        android:pathData="M 72.2,60.8 a 3.2,3.2 0 1,1 -0.001,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="72.2"
                android:startY="57.6"
                android:endX="72.2"
                android:endY="64"
                android:type="linear">
                <item android:color="#FFF176" android:offset="0.0" />
                <item android:color="#FF8F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
