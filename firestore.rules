rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global lock: no public or unauthenticated read/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for user profile data and subcollections
    match /users/{userId} {
      // Users can only read/edit their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Profile subcollection metadata (under users/{userId}/profile/info)
      match /profile/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Check transaction document validations: positive amount, owned by user
      match /transactions/{transactionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId 
          && request.resource.data.userId == userId
          && request.resource.data.amount > 0;
      }

      // Check savings goals: positive targets, owned by user
      match /savings_goals/{goalId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId 
          && request.resource.data.userId == userId
          && request.resource.data.targetAmount > 0;
      }

      // Check debts: positive total amount, owned by user
      match /debts/{debtId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId 
          && request.resource.data.userId == userId
          && request.resource.data.totalAmount > 0;
      }
    }
  }
}
